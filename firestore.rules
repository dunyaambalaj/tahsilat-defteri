rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function girisli() {
      return request.auth != null;
    }
    function sabitAdmin() {
      return girisli()
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'izmirdunyaambalaj@gmail.com';
    }
    function orgMemberYolu(orgId, userId) {
      return /databases/$(database)/documents/organizasyonlar/$(orgId)/uyeler/$(userId);
    }
    function ledgerMemberYolu(ledgerId, userId) {
      return /databases/$(database)/documents/defterler/$(ledgerId)/uyeler/$(userId);
    }
    function orgManager(orgId) {
      return girisli() && exists(orgMemberYolu(orgId, request.auth.uid))
          && get(orgMemberYolu(orgId, request.auth.uid)).data.role in ['owner', 'admin'];
    }
    function orgCanView(orgId) {
      return girisli() && exists(orgMemberYolu(orgId, request.auth.uid))
          && get(orgMemberYolu(orgId, request.auth.uid)).data.role in ['owner', 'admin', 'accounting'];
    }
    function branchManager(ledgerId) {
      return sabitAdmin() || orgManager('dunyaambalaj')
          || (girisli() && exists(ledgerMemberYolu(ledgerId, request.auth.uid))
              && get(ledgerMemberYolu(ledgerId, request.auth.uid)).data.role in ['owner', 'admin']);
    }

    // Sabit yönetici için defterler arası başvuru gelen kutusu.
    match /uyelikBildirimleri/{requestId} {
      function dogrulanmisKullanici() {
        return request.auth != null && request.auth.token.email_verified == true;
      }
      function defterVar(defterId) {
        return exists(/databases/$(database)/documents/defterler/$(defterId)/meta/owner);
      }
      function bekleyenBasvuruAlanlari() {
        return ['defterId', 'uid', 'email', 'name', 'firstName', 'lastName', 'department', 'requestedRole', 'requestedLedgers', 'status', 'createdAt', 'updatedAt'];
      }

      allow get: if sabitAdmin()
          || (girisli() && resource.data.uid == request.auth.uid);
      allow list: if sabitAdmin();
      allow create: if dogrulanmisKullanici()
          && request.resource.data.keys().hasAll(bekleyenBasvuruAlanlari())
          && request.resource.data.keys().hasOnly(bekleyenBasvuruAlanlari())
          && request.resource.data.defterId is string
          && request.resource.data.defterId.matches('^[A-Za-z0-9_-]{16,}$')
          && requestId == request.resource.data.defterId + '__' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 40
          && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 50
          && request.resource.data.department in ['satis', 'operasyon', 'muhasebe', 'diger']
          && request.resource.data.requestedRole in ['admin', 'accounting', 'editor', 'viewer']
          && request.resource.data.requestedLedgers is list
          && request.resource.data.requestedLedgers.size() > 0
          && request.resource.data.requestedLedgers.size() <= 100
          && request.resource.data.requestedLedgers.hasAny([request.resource.data.defterId])
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && defterVar(request.resource.data.defterId)
          && !exists(/databases/$(database)/documents/defterler/$(request.resource.data.defterId)/uyeler/$(request.auth.uid));
      allow update: if (
          sabitAdmin()
          && request.resource.data.keys().hasAll(bekleyenBasvuruAlanlari())
          && request.resource.data.keys().hasAll(['handledAt', 'handledBy'])
          && request.resource.data.keys().hasOnly(['defterId', 'uid', 'email', 'name', 'firstName', 'lastName', 'department', 'requestedRole', 'requestedLedgers', 'status', 'createdAt', 'updatedAt', 'handledAt', 'handledBy'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.handledBy == request.auth.uid
          && request.resource.data.handledAt is string
        ) || (
          dogrulanmisKullanici()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.defterId == resource.data.defterId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending'
          && resource.data.status in ['pending', 'rejected', 'approved']
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasAll(bekleyenBasvuruAlanlari())
          && request.resource.data.keys().hasOnly(bekleyenBasvuruAlanlari())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'firstName', 'lastName', 'department', 'requestedRole', 'requestedLedgers', 'status', 'updatedAt'])
        );
      allow delete: if false;
    }

    // Collection-group sorgusunda yalnız sabit yönetici geçmiş başvuruları tarayabilir.
    match /{path=**}/uyelikBasvurulari/{userId} {
      allow list: if sabitAdmin();
    }

    match /kullaniciProfilleri/{userId} {
      allow get: if girisli() && (request.auth.uid == userId || sabitAdmin() || orgManager('dunyaambalaj'));
      allow list: if false;
      allow create, update: if girisli()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'email', 'firstName', 'lastName', 'fullName', 'department', 'updatedAt'])
          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.fullName is string
          && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /organizasyonlar/{orgId}/uyeler/{userId} {
      allow get: if girisli() && (request.auth.uid == userId || sabitAdmin() || orgManager(orgId));
      allow list: if sabitAdmin() || orgManager(orgId);
      // Yönetici/sahip rolü, aynı organizasyondaki tüm şubelerde geçerlidir.
      // Kullanıcı kendi rolünü yalnızca gerçekten admin/sahip olduğu bir defterden doğrulayabilir.
      allow create: if sabitAdmin() || (
          girisli()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['role', 'uid', 'email', 'name', 'firstName', 'lastName', 'department', 'sourceLedgerId', 'createdAt', 'updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.role in ['owner', 'admin']
          && request.resource.data.sourceLedgerId is string
          && get(ledgerMemberYolu(request.resource.data.sourceLedgerId, userId)).data.role == request.resource.data.role
        ) || (
          orgManager(orgId)
          && request.resource.data.keys().hasOnly(['role', 'uid', 'email', 'name', 'firstName', 'lastName', 'department', 'sourceLedgerId', 'createdAt', 'updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.role in ['owner', 'admin', 'accounting']
          && request.resource.data.sourceLedgerId is string
          && ((request.resource.data.role in ['owner','admin'] && getAfter(ledgerMemberYolu(request.resource.data.sourceLedgerId, userId)).data.role == request.resource.data.role)
            || (request.resource.data.role == 'accounting' && getAfter(ledgerMemberYolu(request.resource.data.sourceLedgerId, userId)).data.role == 'viewer' && getAfter(ledgerMemberYolu(request.resource.data.sourceLedgerId, userId)).data.department == 'muhasebe'))
        );
      allow update: if (girisli() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'firstName', 'lastName', 'email', 'updatedAt'])) || sabitAdmin() || (
          orgManager(orgId)
          && request.resource.data.keys().hasOnly(['role', 'uid', 'email', 'name', 'firstName', 'lastName', 'department', 'sourceLedgerId', 'createdAt', 'updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.role in ['owner', 'admin', 'accounting']
          && request.resource.data.sourceLedgerId is string
          && ((request.resource.data.role in ['owner','admin'] && getAfter(ledgerMemberYolu(request.resource.data.sourceLedgerId, userId)).data.role == request.resource.data.role)
            || (request.resource.data.role == 'accounting' && getAfter(ledgerMemberYolu(request.resource.data.sourceLedgerId, userId)).data.role == 'viewer' && getAfter(ledgerMemberYolu(request.resource.data.sourceLedgerId, userId)).data.department == 'muhasebe'))
        );
      allow delete: if sabitAdmin() || (
          orgManager(orgId)
          && resource.data.sourceLedgerId is string
          && (!existsAfter(ledgerMemberYolu(resource.data.sourceLedgerId, userId))
              || getAfter(ledgerMemberYolu(resource.data.sourceLedgerId, userId)).data.role in ['editor', 'viewer'])
        ) || (
          girisli() && request.auth.uid == userId && request.resource == null
        );
    }

    match /organizasyonlar/{orgId}/defterler/{ledgerId} {
      allow get, list: if girisli();
      allow create, update: if branchManager(ledgerId)
          && request.resource.data.keys().hasOnly(['ledgerId', 'companyName', 'branchName', 'updatedAt', 'updatedBy'])
          && request.resource.data.ledgerId == ledgerId
          && request.resource.data.companyName is string
          && request.resource.data.branchName is string
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /kullaniciDefterleri/{userId}/defterler/{ledgerId} {
      allow get, list: if girisli() && (request.auth.uid == userId || sabitAdmin() || orgManager('dunyaambalaj'));
      allow create, update: if (branchManager(ledgerId) || (girisli() && request.auth.uid == userId))
          && request.resource.data.keys().hasOnly(['ledgerId', 'role', 'companyName', 'branchName', 'updatedAt'])
          && request.resource.data.ledgerId == ledgerId
          && request.resource.data.role == getAfter(ledgerMemberYolu(ledgerId, userId)).data.role
          && request.resource.data.companyName is string
          && request.resource.data.branchName is string
          && request.resource.data.updatedAt is string;
      allow delete: if branchManager(ledgerId);
    }

    match /defterler/{defterId} {
      function uyeYolu(userId) {
        return /databases/$(database)/documents/defterler/$(defterId)/uyeler/$(userId);
      }
      function basvuruYolu(userId) {
        return /databases/$(database)/documents/defterler/$(defterId)/uyelikBasvurulari/$(userId);
      }
      function sahipYolu() {
        return /databases/$(database)/documents/defterler/$(defterId)/meta/owner;
      }
      function uye() {
        return girisli()
            && (orgCanView('dunyaambalaj')
                || (exists(uyeYolu(request.auth.uid))
                    && get(uyeYolu(request.auth.uid)).data.role in ['owner', 'admin', 'editor', 'viewer']));
      }
      function sahip() {
        return sabitAdmin() || orgManager('dunyaambalaj')
            || (uye() && get(uyeYolu(request.auth.uid)).data.role in ['owner', 'admin']);
      }
      function kayitYazabilir() {
        return sabitAdmin() || orgManager('dunyaambalaj')
            || (uye() && get(uyeYolu(request.auth.uid)).data.role in ['owner', 'admin', 'editor']);
      }
      function gecerliUyeVerisi() {
        return request.resource.data.role in ['owner', 'admin', 'editor', 'viewer']
            && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'firstName', 'lastName', 'department', 'addedAt', 'addedBy']);
      }
      function gecerliVeri() {
        return request.resource.data.d is string
            && request.resource.data.d.size() < 600000;
      }

      match /meta/owner {
        // Sistem yöneticisi sabit hesaptır; diğer sahipler yalnızca defter kurulum akışında atanır.
        allow get: if girisli();
        allow list: if false;
        allow create: if girisli()
            && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
            && (sabitAdmin() || (request.resource.data.ownerUid == request.auth.uid && !exists(sahipYolu())));
        allow update: if sabitAdmin() || (
          girisli()
          && resource.data.ownerUid == request.auth.uid
          && get(uyeYolu(request.auth.uid)).data.role == 'owner'
          && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.ownerUid is string
          && request.resource.data.ownerUid != request.auth.uid
          && get(uyeYolu(request.resource.data.ownerUid)).data.role in ['admin', 'editor', 'viewer']
          && getAfter(uyeYolu(request.resource.data.ownerUid)).data.role == 'owner'
        );
        allow delete: if sabitAdmin();
      }

      match /uyeler/{userId} {
        allow get: if girisli() && (userId == request.auth.uid || sahip());
        allow list: if sahip();

        // Sahip admin/düzenleyici/görüntüleyici atayabilir. Defter admini yalnız düzenleyici/görüntüleyici atayabilir.
        allow create: if girisli() && (
          (sabitAdmin() && userId != get(sahipYolu()).data.ownerUid && request.resource.data.role in ['admin', 'editor', 'viewer'] && gecerliUyeVerisi())
          ||
          (uye() && get(uyeYolu(request.auth.uid)).data.role == 'owner'
            && userId != request.auth.uid
            && request.resource.data.role in ['admin', 'editor', 'viewer']
            && gecerliUyeVerisi())
          ||
          (uye() && get(uyeYolu(request.auth.uid)).data.role == 'admin'
            && userId != request.auth.uid
            && request.resource.data.role in ['editor', 'viewer']
            && gecerliUyeVerisi())
          ||
          (orgManager('dunyaambalaj') && userId != request.auth.uid
            && request.resource.data.role in ['admin', 'editor', 'viewer']
            && gecerliUyeVerisi())
          ||
          (userId == request.auth.uid
            && request.resource.data.role == 'owner'
            && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'firstName', 'lastName', 'department', 'addedAt'])
            && get(sahipYolu()).data.ownerUid == request.auth.uid)
        );

        allow update: if (
          girisli()
          && userId == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'firstName', 'lastName', 'department'])
          && gecerliUyeVerisi()
        ) || (
          sabitAdmin()
          && ((userId == get(sahipYolu()).data.ownerUid && request.resource.data.role == 'owner')
            || (userId != get(sahipYolu()).data.ownerUid && request.resource.data.role in ['admin', 'editor', 'viewer']))
          && gecerliUyeVerisi()
        ) || (
          uye()
          && get(uyeYolu(request.auth.uid)).data.role == 'owner'
          && userId != request.auth.uid
          && userId != get(sahipYolu()).data.ownerUid
          && request.resource.data.role in ['admin', 'editor', 'viewer']
          && gecerliUyeVerisi()
        ) || (
          girisli()
          && get(sahipYolu()).data.ownerUid == request.auth.uid
          && get(uyeYolu(request.auth.uid)).data.role == 'owner'
          && userId == request.auth.uid
          && resource.data.role == 'owner'
          && request.resource.data.role == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && getAfter(sahipYolu()).data.ownerUid != request.auth.uid
          && getAfter(uyeYolu(getAfter(sahipYolu()).data.ownerUid)).data.role == 'owner'
        ) || (
          girisli()
          && get(sahipYolu()).data.ownerUid == request.auth.uid
          && get(uyeYolu(request.auth.uid)).data.role == 'owner'
          && userId != request.auth.uid
          && resource.data.role in ['admin', 'editor', 'viewer']
          && request.resource.data.role == 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && getAfter(sahipYolu()).data.ownerUid == userId
        ) || (
          uye()
          && get(uyeYolu(request.auth.uid)).data.role == 'admin'
          && userId != request.auth.uid
          && resource.data.role in ['editor', 'viewer']
          && request.resource.data.role in ['editor', 'viewer']
          && gecerliUyeVerisi()
        ) || (
          orgManager('dunyaambalaj')
          && userId != request.auth.uid
          && request.resource.data.role in ['admin', 'editor', 'viewer']
          && gecerliUyeVerisi()
        );

        allow delete: if (sabitAdmin() && userId != get(sahipYolu()).data.ownerUid)
          || (uye()
            && get(uyeYolu(request.auth.uid)).data.role == 'owner'
            && userId != request.auth.uid
            && userId != get(sahipYolu()).data.ownerUid)
          || (uye()
            && get(uyeYolu(request.auth.uid)).data.role == 'admin'
            && userId != request.auth.uid
            && resource.data.role in ['editor', 'viewer'])
          || (orgManager('dunyaambalaj') && userId != request.auth.uid);
      }

      match /uyelikBasvurulari/{userId} {
        allow get: if girisli() && (userId == request.auth.uid || sahip());
        allow list: if sahip();
        allow create: if girisli()
            && request.auth.token.email_verified == true
            && userId == request.auth.uid
            && !exists(uyeYolu(userId))
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.status == 'pending'
            && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'firstName', 'lastName', 'department', 'requestedRole', 'requestedLedgers', 'status', 'createdAt', 'updatedAt'])
            && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 40
            && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 50
            && request.resource.data.department in ['satis', 'operasyon', 'muhasebe', 'diger']
            && request.resource.data.requestedRole in ['admin', 'accounting', 'editor', 'viewer']
            && request.resource.data.requestedLedgers is list
            && request.resource.data.requestedLedgers.size() > 0 && request.resource.data.requestedLedgers.size() <= 100
            && request.resource.data.requestedLedgers.hasAny([defterId]);
        allow update: if (
            sahip()
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.handledBy == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'firstName', 'lastName', 'department', 'requestedRole', 'requestedLedgers', 'status', 'createdAt', 'updatedAt', 'handledAt', 'handledBy'])
          ) || (
            girisli()
            && request.auth.token.email_verified == true
            && userId == request.auth.uid
            && resource.data.status in ['pending', 'approved', 'rejected']
            && request.resource.data.status == 'pending'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'firstName', 'lastName', 'department', 'requestedRole', 'requestedLedgers', 'status', 'createdAt', 'updatedAt'])
            && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 40
            && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 50
            && request.resource.data.department in ['satis', 'operasyon', 'muhasebe', 'diger']
            && request.resource.data.requestedRole in ['admin', 'accounting', 'editor', 'viewer']
            && request.resource.data.requestedLedgers is list
            && request.resource.data.requestedLedgers.size() > 0 && request.resource.data.requestedLedgers.size() <= 100
            && request.resource.data.requestedLedgers.hasAny([defterId])
          );
        allow delete: if false;
      }

      match /{koleksiyon}/{belgeId} {
        allow read: if (sabitAdmin() || uye())
            && koleksiyon in ['kayitlar', 'ayar', 'aktif', 'cihaz'];
        allow create, update: if gecerliVeri() && (
            (koleksiyon == 'kayitlar' && kayitYazabilir())
            || (koleksiyon == 'ayar' && sahip())
            || (koleksiyon in ['aktif', 'cihaz'] && uye())
          );
        allow delete: if sabitAdmin()
            || (uye() && kayitYazabilir() && koleksiyon == 'kayitlar')
            || (uye() && sahip() && koleksiyon == 'ayar' && belgeId == 'kasa')
            || (uye() && koleksiyon in ['aktif', 'cihaz']);
      }
    }
  }
}