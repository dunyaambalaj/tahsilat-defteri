rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function girisli() {
      return request.auth != null;
    }
    function sabitAdmin() {
      return girisli()
          && request.auth.token.email_verified == true
          && request.auth.token.email == 'izmirdunyaambalaj@gmail.com';
    }

    // Sabit yönetici için defterler arası başvuru gelen kutusu.
    match /uyelikBildirimleri/{requestId} {
      function dogrulanmisKullanici() {
        return request.auth != null && request.auth.token.email_verified == true;
      }
      function defterVar(defterId) {
        return exists(/databases/$(database)/documents/defterler/$(defterId)/meta/owner);
      }
      function bekleyenBasvuruAlanlari() {
        return ['defterId', 'uid', 'email', 'name', 'status', 'createdAt', 'updatedAt'];
      }

      allow get: if sabitAdmin()
          || (girisli() && resource.data.uid == request.auth.uid);
      allow list: if sabitAdmin();
      allow create: if dogrulanmisKullanici()
          && request.resource.data.keys().hasAll(bekleyenBasvuruAlanlari())
          && request.resource.data.keys().hasOnly(bekleyenBasvuruAlanlari())
          && request.resource.data.defterId is string
          && request.resource.data.defterId.matches('^[A-Za-z0-9_-]{16,}$')
          && requestId == request.resource.data.defterId + '__' + request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && defterVar(request.resource.data.defterId)
          && !exists(/databases/$(database)/documents/defterler/$(request.resource.data.defterId)/uyeler/$(request.auth.uid));
      allow update: if (
          sabitAdmin()
          && request.resource.data.keys().hasAll(bekleyenBasvuruAlanlari())
          && request.resource.data.keys().hasAll(['handledAt', 'handledBy'])
          && request.resource.data.keys().hasOnly(['defterId', 'uid', 'email', 'name', 'status', 'createdAt', 'updatedAt', 'handledAt', 'handledBy'])
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.handledBy == request.auth.uid
          && request.resource.data.handledAt is string
        ) || (
          dogrulanmisKullanici()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.defterId == resource.data.defterId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending'
          && resource.data.status in ['pending', 'rejected', 'approved']
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasAll(bekleyenBasvuruAlanlari())
          && request.resource.data.keys().hasOnly(bekleyenBasvuruAlanlari())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status', 'updatedAt'])
        );
      allow delete: if false;
    }

    match /defterler/{defterId} {
      function uyeYolu(userId) {
        return /databases/$(database)/documents/defterler/$(defterId)/uyeler/$(userId);
      }
      function basvuruYolu(userId) {
        return /databases/$(database)/documents/defterler/$(defterId)/uyelikBasvurulari/$(userId);
      }
      function sahipYolu() {
        return /databases/$(database)/documents/defterler/$(defterId)/meta/owner;
      }
      function uye() {
        return girisli()
            && exists(uyeYolu(request.auth.uid))
            && get(uyeYolu(request.auth.uid)).data.role in ['owner', 'admin', 'editor', 'viewer'];
      }
      function sahip() {
        return sabitAdmin()
            || (uye() && get(uyeYolu(request.auth.uid)).data.role in ['owner', 'admin']);
      }
      function kayitYazabilir() {
        return sabitAdmin()
            || (uye() && get(uyeYolu(request.auth.uid)).data.role in ['owner', 'admin', 'editor']);
      }
      function gecerliUyeVerisi() {
        return request.resource.data.role in ['owner', 'admin', 'editor', 'viewer']
            && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'addedAt', 'addedBy']);
      }
      function gecerliVeri() {
        return request.resource.data.d is string
            && request.resource.data.d.size() < 600000;
      }

      match /meta/owner {
        // Sistem yöneticisi sabit hesaptır; diğer sahipler yalnızca defter kurulum akışında atanır.
        allow get: if girisli();
        allow list: if false;
        allow create: if girisli()
            && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
            && (sabitAdmin() || (request.resource.data.ownerUid == request.auth.uid && !exists(sahipYolu())));
        allow update, delete: if sabitAdmin();
      }

      match /uyeler/{userId} {
        allow get: if girisli() && (userId == request.auth.uid || sahip());
        allow list: if sahip();

        // Sahip admin/düzenleyici/görüntüleyici atayabilir. Defter admini yalnız düzenleyici/görüntüleyici atayabilir.
        allow create: if girisli() && (
          (sabitAdmin() && userId != get(sahipYolu()).data.ownerUid && request.resource.data.role in ['admin', 'editor', 'viewer'] && gecerliUyeVerisi())
          ||
          (uye() && get(uyeYolu(request.auth.uid)).data.role == 'owner'
            && userId != request.auth.uid
            && request.resource.data.role in ['admin', 'editor', 'viewer']
            && gecerliUyeVerisi())
          ||
          (uye() && get(uyeYolu(request.auth.uid)).data.role == 'admin'
            && userId != request.auth.uid
            && request.resource.data.role in ['editor', 'viewer']
            && gecerliUyeVerisi())
          ||
          (userId == request.auth.uid
            && request.resource.data.role == 'owner'
            && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'addedAt'])
            && get(sahipYolu()).data.ownerUid == request.auth.uid)
        );

        allow update: if (
          sabitAdmin()
          && ((userId == get(sahipYolu()).data.ownerUid && request.resource.data.role == 'owner')
            || (userId != get(sahipYolu()).data.ownerUid && request.resource.data.role in ['admin', 'editor', 'viewer']))
          && gecerliUyeVerisi()
        ) || (
          uye()
          && get(uyeYolu(request.auth.uid)).data.role == 'owner'
          && userId != request.auth.uid
          && userId != get(sahipYolu()).data.ownerUid
          && request.resource.data.role in ['admin', 'editor', 'viewer']
          && gecerliUyeVerisi()
        ) || (
          uye()
          && get(uyeYolu(request.auth.uid)).data.role == 'admin'
          && userId != request.auth.uid
          && resource.data.role in ['editor', 'viewer']
          && request.resource.data.role in ['editor', 'viewer']
          && gecerliUyeVerisi()
        );

        allow delete: if (sabitAdmin() && userId != get(sahipYolu()).data.ownerUid)
          || (uye()
            && get(uyeYolu(request.auth.uid)).data.role == 'owner'
            && userId != request.auth.uid
            && userId != get(sahipYolu()).data.ownerUid)
          || (uye()
            && get(uyeYolu(request.auth.uid)).data.role == 'admin'
            && userId != request.auth.uid
            && resource.data.role in ['editor', 'viewer']);
      }

      match /uyelikBasvurulari/{userId} {
        allow get: if girisli() && (userId == request.auth.uid || sahip());
        allow list: if sahip();
        allow create: if girisli()
            && request.auth.token.email_verified == true
            && userId == request.auth.uid
            && !exists(uyeYolu(userId))
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.status == 'pending'
            && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'status', 'createdAt', 'updatedAt']);
        allow update: if (
            sahip()
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.handledBy == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'status', 'createdAt', 'updatedAt', 'handledAt', 'handledBy'])
          ) || (
            girisli()
            && request.auth.token.email_verified == true
            && userId == request.auth.uid
            && resource.data.status in ['approved', 'rejected']
            && request.resource.data.status == 'pending'
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'status', 'createdAt', 'updatedAt'])
          );
        allow delete: if false;
      }

      match /{koleksiyon}/{belgeId} {
        allow read: if (sabitAdmin() || uye())
            && koleksiyon in ['kayitlar', 'ayar', 'aktif', 'cihaz'];
        allow create, update: if gecerliVeri() && (
            (koleksiyon == 'kayitlar' && kayitYazabilir())
            || (koleksiyon == 'ayar' && sahip())
            || (koleksiyon in ['aktif', 'cihaz'] && uye())
          );
        allow delete: if sabitAdmin()
            || (uye() && kayitYazabilir() && koleksiyon == 'kayitlar')
            || (uye() && sahip() && koleksiyon == 'ayar' && belgeId == 'kasa')
            || (uye() && koleksiyon in ['aktif', 'cihaz']);
      }
    }
  }
}